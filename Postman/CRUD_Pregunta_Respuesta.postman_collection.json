{
  "info": {
    "name": "CRUD Pregunta y Respuesta",
    "description": "Pruebas de /api/preguntas y /api/respuestas. Crea una pregunta y una respuesta de prueba y las elimina al final. Requiere la base con los datos de prueba (usuarios 1-6 y lecciones 1-4).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Pregunta",
      "item": [
        {
          "name": "Crear pregunta (estudiante 6, lección 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve estudiante y lección\", function () { pm.expect(j.nombreEstudiante).to.be.a(\"string\"); pm.expect(j.tituloLeccion).to.be.a(\"string\"); pm.expect(j.fecha).to.be.a(\"string\"); });",
                  "pm.test(\"Incluye cabecera Location\", function () { pm.expect(pm.response.headers.has(\"Location\")).to.be.true; });",
                  "pm.collectionVariables.set(\"idPregunta\", j.idPregunta);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preguntas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "preguntas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idUsuario\": 6,\n  \"idLeccion\": 1,\n  \"contenido\": \"¿Para qué sirve el atributo alt en una imagen?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar preguntas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Es una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ],
