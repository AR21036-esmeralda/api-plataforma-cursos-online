{
  "info": {
    "name": "Entrega 3 - Relaciones (Inscripciones, Progresos, Categorias, Roles e Intentos)",
    "description": "Demo ejecutable de las relaciones de la Entrega #3. Ejecutar las carpetas en orden con el Collection Runner: autenticación → preparación → inscripciones → progresos → evaluación e intento → baja y limpieza. Todas las peticiones usan {{baseUrl}} (http://localhost:8081) y tienen assertions pm.test. Los POST encadenan sus IDs con variables de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Autenticación y catálogos",
      "description": "Login y catálogo de roles.",
      "item": [
        {
          "name": "POST /api/auth/login (CU02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El login devuelve token y datos del administrador\", function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property(\"token\");",
                  "    pm.expect(j.email).to.eql(\"admin@plataforma.com\");",
                  "    pm.expect(j.rol).to.eql(\"ADMINISTRADOR\");",
                  "    pm.collectionVariables.set(\"token\", j.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Credenciales de prueba: admin@plataforma.com / admin123. Guarda el token en la variable token."
          },
          "response": []
        },
        {
          "name": "GET /api/roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta es una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Existe el rol ESTUDIANTE\", function () {",
                  "    const est = pm.response.json().find(r => r.nombreRol === \"ESTUDIANTE\");",
                  "    pm.expect(est, \"El catálogo debe incluir ESTUDIANTE\").to.exist;",
                  "    pm.collectionVariables.set(\"idRolEstudiante\", String(est.idRol));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/roles",
            "description": "Catálogo de roles. Guarda el id del rol ESTUDIANTE para crear el usuario de la demo."
          },
          "response": []
        },
        {
          "name": "POST /api/roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 o 409 (rol ya registrado)\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Respuesta coherente con el resultado\", function () {",
                  "    const j = pm.response.json();",
                  "    if (pm.response.code === 201) {",
                  "        pm.expect(j).to.have.property(\"idRol\");",
                  "        pm.collectionVariables.set(\"idRol\", String(j.idRol));",
                  "    } else {",
                  "        pm.expect(j).to.have.property(\"mensaje\");",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreRol\": \"ESTUDIANTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "La API sólo permite ADMINISTRADOR/ESTUDIANTE/PROFESOR y ya existen en la BD de prueba: la respuesta válida es 201 (si no existe) o 409 (duplicado)."
          },
          "response": []
        }
      ]
    },
