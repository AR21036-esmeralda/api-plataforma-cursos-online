{
  "info": {
    "name": "CRUD Leccion - API Cursos Online",
    "description": "Pruebas del CRUD de Lección y su relación con Curso. Ejecutar en orden lógico y sustituir las variables por IDs existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "idCurso",
      "value": "1"
    },
    {
      "key": "idLeccion",
      "value": ""
    },
    {
      "key": "idLeccionExistente",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - Listar todas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lecciones",
        "description": "Esperado: 200 OK y lista JSON."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"La respuesta es una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Filtrar por curso",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lecciones?idCurso={{idCurso}}",
        "description": "Esperado: 200 OK; las lecciones aparecen ordenadas por número de orden."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Todas pertenecen al curso indicado\", function () {",
              "    const idCurso = Number(pm.collectionVariables.get(\"idCurso\"));",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "    pm.response.json().forEach(l => pm.expect(l.idCurso).to.eql(idCurso));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Obtener por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lecciones/{{idLeccionExistente}}",
        "description": "Esperado: 200 OK si existe; 404 si no existe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"La respuesta trae idLeccion y titulo\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j).to.have.property(\"idLeccion\");",
              "    pm.expect(j.titulo).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Crear lección",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lecciones",
        "description": "El curso indicado debe existir. Esperado: 201 Created.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Introducción a Java\",\n  \"contenido\": \"Conceptos básicos de programación en Java.\",\n  \"orden\": 3,\n  \"idCurso\": {{idCurso}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"La respuesta trae idLeccion\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j).to.have.property(\"idLeccion\");",
              "    pm.expect(j.idLeccion).to.be.a(\"number\");",
              "    pm.expect(j.titulo).to.eql(\"Introducción a Java\");",
              "    pm.collectionVariables.set(\"idLeccion\", String(j.idLeccion));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Validación título vacío",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lecciones",
        "description": "Esperado: 400 Bad Request por validación.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \" \",\n  \"contenido\": \"Contenido de prueba\",\n  \"orden\": 2,\n  \"idCurso\": {{idCurso}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"El error indica validación\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"mensaje\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Curso inexistente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lecciones",
        "description": "Esperado: 404 Not Found si no existe el curso 999999.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Lección de prueba\",\n  \"contenido\": \"Contenido\",\n  \"orden\": 99,\n  \"idCurso\": 999999\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"El error indica que no existe el curso\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"mensaje\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Actualizar lección",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lecciones/{{idLeccion}}",
        "description": "Esperado: 200 OK. El orden no puede repetirse dentro del mismo curso.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Introducción a Java actualizada\",\n  \"contenido\": \"Contenido actualizado.\",\n  \"orden\": 3,\n  \"idCurso\": {{idCurso}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"La lección se actualizó\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j).to.have.property(\"idLeccion\");",
              "    pm.expect(j.titulo).to.eql(\"Introducción a Java actualizada\");",
              "    pm.expect(j.orden).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Eliminar lección",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/lecciones/{{idLeccion}}",
        "description": "Esperado: 204 No Content."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
