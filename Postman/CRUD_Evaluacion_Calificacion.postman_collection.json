{
  "info": {
    "name": "CRUD Evaluación y Calificación",
    "description": "Pruebas de /api/evaluaciones y /api/calificaciones. Crea un curso temporal y lo elimina al final. Requiere la base con los datos de prueba (usuarios 1-6, evaluaciones 1-2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Preparación",
      "item": [
        {
          "name": "Crear curso temporal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"idCursoTmp\", pm.response.json().idCurso);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCurso\": \"Curso temporal para evaluación\",\n  \"descripcion\": \"Creado por la colección de pruebas\",\n  \"estado\": true,\n  \"idCategoria\": 1,\n  \"idProfesor\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1 - Evaluación",
      "item": [
        {
          "name": "Crear evaluación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve id y nombre del curso\", function () { pm.expect(j.idEvaluacion).to.be.a(\"number\"); pm.expect(j.nombreCurso).to.be.a(\"string\"); });",
                  "pm.test(\"Incluye cabecera Location\", function () { pm.expect(pm.response.headers.has(\"Location\")).to.be.true; });",
                  "pm.collectionVariables.set(\"idEvaluacion\", j.idEvaluacion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/evaluaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "evaluaciones"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Evaluación del curso temporal\",\n  \"descripcion\": \"Examen de prueba\",\n  \"idCurso\": \"{{idCursoTmp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar evaluaciones",
